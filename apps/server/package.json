{
	"name": "server",
	"private": true,
	"type": "module",
	"exports": {
		"./types": {
			"types": "./src/types.ts"
		}
	},
	"scripts": {
		"dev": "wrangler dev --port=8787",
		"build": "pnpm check-types && wrangler deploy --dry-run --outdir dist",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"deploy": "wrangler deploy --minify",
		"typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"dependencies": {
		"@hono/trpc-server": "^0.4.2",
		"@meet/contracts": "workspace:*",
		"@trpc/server": "11.19.0",
		"hono": "^4.13.13",
		"jose": "^6.2.12",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"typescript": "~7.0.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	}
}
