{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/dist",
			"!!**/.wrangler",
			"!!**/.turbo",
			"!!**/worker-configuration.d.ts",
			"!!**/routeTree.gen.ts",
			"!!**/pnpm-lock.yaml",
			"!!**/*.svg",
			"!!**/*firebase-adminsdk*.json",
			"!!**/*service-account*.json",
			"!!**/.dev.vars",
			"!!**/.dev.vars.*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
