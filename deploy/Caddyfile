# Append these site blocks to /etc/caddy/Caddyfile on Lightsail.
# Replace the example domains before deploying.
# Caddy obtains and renews public HTTPS certificates automatically.

your-domain.example.com {
	root * /www/wwwroot/meet-web
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

your-api-domain.example.com {
	reverse_proxy 127.0.0.1:8787
}
